{
  "name": "dsh-doclib",
  "version": "0.4.0",
  "description": "资料库：一个插件、一个页面——笔记库（递归文件夹读写 md/文本/图片/电子书，Obsidian 式编辑与阅读，带划线与快照）。",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./vault": "./index.js",
    "./vault/locale/*.json": "./locale/vault/*.json",
    "./vault/icon": "./icon-vault.svg"
  },
  "files": [
    "index.js",
    "store.js",
    "studio-binding.js",
    "copy-desk.js",
    "write-desk.js",
    "ai-edit.js",
    "libraries.js",
    "vault.js",
    "reader-settings.js",
    "annotations.js",
    "ebook.js",
    "client.js",
    "cordis.patch.yml",
    "locale/**/*.json",
    "icon.svg",
    "icon-vault.svg",
    "README.md",
    "LICENSE",
    "history.js",
    "studio-session.js"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lerwa2025-a11y/dsh-doclib.git"
  },
  "homepage": "https://github.com/lerwa2025-a11y/dsh-doclib#readme",
  "bugs": {
    "url": "https://github.com/lerwa2025-a11y/dsh-doclib/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notes",
    "markdown",
    "ebook"
  ],
  "license": "MIT",
  "dependencies": {
    "@lingo-reader/mobi-parser": "^0.4.6"
  }
}
